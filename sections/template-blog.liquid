<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {% comment %} <pre>{{ blog.articles | json }}</pre> {% endcomment %}
  {% paginate blog.articles by section.settings.articles_per_page %}

    {% comment %} {% for article in blog.articles %} {% endcomment %}
    {% for article in blog.articles %}
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <img
          class="w-full h-48 object-cover"
          src="{{ article.image | img_url: 'large'}}"
          alt="Blog Image"
          height="100"
          width="100"
        >
        <div class="p-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-2">{{ article.title }}</h2>
          <p class="text-sm text-gray-500 mb-2">{{ article.author }} | {{ article.published_at }}</p>
          <p class="text-gray-600 mb-4">
            {{ article.content | truncate: 150 }}
          </p>
          <a href="{{ article.url }}" class="text-blue-500 hover:underline">Read More</a>
        </div>
      </div>
    {% endfor %}
   {% comment %} <div class="mt-8 flex justify-center">
      {% if paginate.pages > 1 %}
        <nav class="inline-flex space-x-4">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300">
              Previous
            </a>
          {% endif %}

          {% for i in (1..paginate.pages) %}
            <a
              href="{{ paginate.page_url | replace: ':current_page', i }}"
              class="px-4 py-2 {{ paginate.current_page == i ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-800 hover:bg-gray-300' }} rounded"
            >
              {{ i }}
            </a>
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300">
              Next
            </a>
          {% endif %}
        </nav>
      {% endif %}
    </div> {% endcomment %}
  {% endpaginate %}
</div>


{% schema %}
 {
    "name": "Blog",
    "settings": [
        {
            "type" : "range",
            "id": "articles_per_page",
            "label": "Articles per page",
            "min": 1,
            "max": 6,
            "default" : 3
        }
    ]
}
{% endschema %}