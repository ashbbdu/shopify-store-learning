{% comment %} {% comment %} {% for block in section.blocks %}
  {% case block.type %}
    {% when 'article_title' %}
      <h1>{{ article.title }}</h1>
    {% when 'article_author' %}
      <small>{{ article.author }}</small>
    {% when 'article_published_date' %}
      <time datetime="{{ article.published_at | date : "%y-%m-%d" }}">
        {{- article.published_at | date: '%y-%m-%d' -}}
      </time>
    {% when 'article_image' %}
      <img src="{{ article.image | img_url: 'medium' }}" alt="{{ article.title }}" height="200" width="200">
    {% when 'article_content' %}
      <p>{{ article.content }}</p>
  {% endcase %}
{% endfor %} {% endcomment %} {% endcomment %}


<article class="py-8">
    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'article_title' %}
                <div class="flex items-center justify-center">
                    <div class="max-w-7xl text-center">
                        <a href="{{ blog.url }}" class="text-base uppercase text-gray-500 hover:text-gray-900 font-bold">{{ blog.title }}</a>
                        <h1 class="text-4xl md:text-6xl font-medium">{{ article.title }}</h1>
                    </div>
                </div>
            {% when 'article_author' %}
                <div class="flex items-center justify-center">
                    <div class="max-w-7xl text-center">
                        {% if section.settings.show_author %}
                            <small>{{ article.author }}</small>
                        {% endif %}
                    </div>
                </div>
            {% when 'article_published_date' %}
                <div class="flex items-center justify-center">
                    <div class="max-w-7xl text-center">
                        {% if section.settings.show_published_date %}
                            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'on_date' }}</time>
                        {% endif %}
                    </div>
                </div>
            {% when 'article_image' %}
                <div class="max-w-7xl bg-blue-100 rounded-lg mx-2 md:mx-auto overflow-hidden my-4">
        
                        <img class="w-full h-80 md:h-96 object-cover object-center" src="{{ article.image | img_url: 'large'}}" alt="{{ article.image.alt }}" height="200" width="200">
                   
                </div>
                
            {% when 'article_content' %}
                <div class="flex items-center justify-center">
                    <div class="max-w-4xl">
                        {{ article.content }}
                    </div>
                </div> 
            {% else %}
        {% endcase %}
    {% endfor %}
</article>


{% if blog.comments_enabled? %}
    <div class="max-w-7xl mx-auto">
        <div class="flex justify-center">
        <div class="max-w-4xl">
            {% if article.comments.count > 0 %}
                <h2 class="text-2xl font-medium">Comments</h2>
                <div class="mt-4">
                    {% for comment in article.comments %}
                        <div class="bg-gray-100 p-4 rounded-lg my-2">
                            <p class="text-sm font-medium">{{ comment.author.name }}</p>
                            <p class="text-sm">{{ comment.content }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>No comments yet</p>
              
            {% endif %}
        </div>
        </div>
    </div>
  
    
{% endif %}

<div class="comment-form bg-white p-6 rounded-lg shadow-md max-w-2xl mx-auto">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Leave a Comment</h2>
    {% form 'new_comment', article %}
        <div class="flex-1 mx-auto items-center justify-center max-w-4xl px-4">
            {% if form.errors %}
                <div class="border p-5">
                    <div class="flex flex-row items-center w-full my-3">
                        <div class="text-red-500">
                            {% render 'icon-failed' %}
                        </div>
                        <div class="text-sm font-medium ml-3">
                            Oh no! Your comment was not posted
                        </div>
                    </div>
                    <ul class="px-4 mb-3 ml-7 list-decimal">
                        {% for error in form.errors %}
                            <li>
                                <span>{{ form.errors.messages[error] }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% elsif form.posted_successfully? %}
                <div class="flex flex-row items-center w-full my-3 p-5">
                    <div class="text-green-500">
                        {% render 'icon-success' %}
                    </div>
                    <div class="text-sm font-medium ml-3">Comment is posted successfully</div>
                </div>
            {% endif %}
            <div class="px-1 md:flex mb-3">
                <div class="px-3 md:w-1/2">
                    <label for="comment_author" class="text-gray-700 font-medium uppercase text-xs mb-2">Name</label>
                    <input 
                        type="text" 
                        name="comment[author]" 
                        id="comment_author" 
                        class="w-full text-gray-700 border py-3 px-4 mb-3 focus:outline-none"
                        placeholder="Jane Doe"
                        required
                    >
                </div>
                <div class="px-3 md:w-1/2">
                    <label for="comment_email" class="text-gray-700 font-medium uppercase text-xs mb-2">Email</label>
                    <input 
                        type="email" 
                        name="comment[email]" 
                        id="comment_email" 
                        class="w-full text-gray-700 border py-3 px-4 mb-3 focus:outline-none"
                        placeholder="jane@doe.com"
                        required
                    >
                </div>
            </div>
            <div class="px-1 md:flex mb-3">
                <div class="md:w-full px-3">
                    <label for="comment_content" class="text-gray-700 font-medium uppercase text-xs mb-2">Comment</label>
                    <textarea class="w-full text-gray-700 resize-none h-20 py-2 px-3 focus:outline-none border" name="comment[body]" id="comment_content" required></textarea>
                </div>
            </div>
            <div class="px-1 md:flex mb-3">
                <div class="md:w-full px-3">
                    <input type="submit" class="w-full cursor-pointer px-4 py-2 border text-base font-medium text-white bg-gray-900 hover:bg-gray-500" value="Post comment">
                </div>
            </div>
        </div>
    {% endform %}
</div>


{% schema %}
{
  "name": "Article Template",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Display Author Name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_published_date",
      "label": "Display Published Date",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "article_title",
      "name": "Article Title",
      "limit": 1
    },
    {
      "type": "article_author",
      "name": "Article Author",
      "limit": 1
    },
    {
      "type": "article_published_date",
      "name": "Article Published Date",
      "limit": 1
    },
    {
      "type": "article_image",
      "name": "Article Image",
      "limit": 1
    },
    {
      "type": "article_content",
      "name": "Article Content",
      "limit": 1
    }
  ]
}
{% endschema %}
