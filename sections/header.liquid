{% comment %} {{ shop.customer_accounts_enabled }} {% endcomment %}
<div class="relative bg-white" x-data="{ mobileMenuOpen: false }" >
    <div class="mx-auto px-4 sm:px-6">
      <div class="flex justify-between items-center py-6 md:justify-start md:space-x-10">
        <!-- STORE NAME / STORE LOGO -->
        <div class="flex justify-start lg:flex-1 truncate">
          <h1 class="text-xl font-bold truncate text-red">{{ shop.name }}</h1>
        </div>

        {% comment %} Hamburger Menu {% endcomment %}
        <div class="-mr-2 -my-2 ml-3 md:hidden">
            <button x-on:click="mobileMenuOpen = !mobileMenuOpen" type="button" class="bg-white p-2 inline-flex items-center justify-center focus:outline-none">
               {% render 'icon-menu' %} 
            </button>
        </div>
        
  
        <!-- NAVIGATION MENU -->
        <nav class="hidden md:flex space-x-10">
          {% for link in linklists[section.settings.menu].links %}
            <div x-data="{ open: false }"  @click.outside="open = false"  class="relative">
              {% if link.links.size > 0 %}
                <a x-on:click="open = !open" id="link-{{ forloop.index }}" href="{{ link.url }}" class="text-base text-gray-500 hover:text-gray-900">
                  {{ link.title }}
                </a>
                
                <!-- Dropdown -->
                <div x-show="open" x-cloak>
                  <div class="absolute z-10 -ml-5 mt-5 px-2 w-screen max-w-md sm:px-0 lg:ml-0 lg:left-1/2 lg:-translate-x-1/2">
                    <div class="shadow-lg border ring-black ring-opacity-5 overflow-hidden rounded-lg">
                      <div class="relative grid gap-6 bg-white px-5 py-6 sm:gap-8 sm:p-8">
                        {% for sublink in link.links %}
                          <a href="{{ sublink.url }}" class="-m-3 p-3 flex items-start rounded-lg hover:bg-gray-100">
                            <div class="ml-4">
                              <p class="text-gray-900 text-base font-medium">
                                {{ sublink.title }}
                              </p>
                            </div>
                          </a>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </div>
              {% else %}
                <a href="{{ link.url }}" class="text-base text-gray-500 hover:text-gray-900">{{ link.title }}</a>
              {% endif %}
            </div>
          {% endfor %}
        </nav>
  
        <div class="hidden md:flex items-center justify-end md:flex-1 space-x-5">
          <a href="{{ routes.cart_url }}" class="whitespace-nowrap text-base text-gray-500 hover:text-gray-900">
            Cart
          </a>

          {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_login_url }}" class="text-base text-gray-500 hover:text-gray-900">Login</a>
          <a href="{{ routes.account_register_url }}" class="text-base text-gray-500 hover:text-gray-900">Register</a>
          {% endif %}

        </div>
      </div>
    </div>

    {% comment %} Mobile menu content {% endcomment %}
    {% comment %} x-data="{ mobileMenuOpen: false }"  {% endcomment %}
   
    <div x-show="mobileMenuOpen" class="absolute z-10 top-0 inset-x-0 p-2 transform origin-top-left md:hidden" @click.outside="mobileMenuOpen = false">
        <div class="shadow-lg rounded-lg ring-1 ring-black ring-opacity-5 bg-white w-full">
            <div class="p-5 divide-y-2 divide-gray-50">
    
                <!-- MOBILE MENU HEADER TITLE PLUS CLOSE BUTTON -->
                <div class="flex items-center justify-between pb-3">
                    <div>
                        <h1 class="text-lg text-gray-500">{{ section.settings.mobile_menu_title }}</h1>
                    </div>
                    <div class="-mr-2">
                        <button x-on:click="mobileMenuOpen = false" type="button" class="bg-white rounded-md p-2 text-gray-500 cursor-pointer">
                            {% render 'icon-cancel' %}
                        </button>
                    </div>
                </div>
    
                <!-- NAVIGATION LINKS FOR MOBILE MENU -->
                <div class="pt-3">
                    <nav class="grid gap-y-7">
    
                        <a href="#" class="-m-3 p-3 flex items-center rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                            LINK ITEM
                        </a>
    
                        <a href="#" class="-m-3 p-3 flex items-center rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                            LINK ITEM
                        </a>
    
                        <div class="relative">
                            <button type="button" class="text-base text-gray-500 hover:text-gray-900 flex items-center justify-between w-full">
                                <div>LINK ITEM</div>
                            </button>
    
                            <div class="grid gap-y-7 py-3">
                                <a href="#" class="-m-3 p-3 mt-2 flex items-center rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                                    <span class="ml-3 text-base font-medium text-gray-500">CHILDLINK ITEM</span>
                                </a>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </div>
  </div>
  
{% schema %}
{
  "name": "Header",
  "settings": [
    {
        "type" : "text", 
        "id": "mobile_menu_title",
        "label": "title",
        "default": "Menu",
        "info": "This is fo the mobile menu window"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default" : "main-menu",
        "info": "Select the main menu to display in the header"
    }

  ]
}
{% endschema %}